# ══════════════════════════════════════════════
# 百合小说导航站 · 缓存策略
# 目标：让访客的重复访问几乎零请求
# ══════════════════════════════════════════════

# ── 页面：不缓存（保证看到最新版）──
/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/sw.js
  Cache-Control: no-cache, must-revalidate

# ── 数据分片：不缓存（保证新数据立即生效 ✗）──
/data/*
  Cache-Control: no-cache, must-revalidate

# ── 静态资源：缓存 1 天（URL 带 ?v= 版本号）──
/app.js
  Cache-Control: public, max-age=86400

/style.css
  Cache-Control: public, max-age=86400

/sites.json
  Cache-Control: public, max-age=86400

/manifest.json
  Cache-Control: public, max-age=86400

# ── 图片：缓存 7 天 ──
/avatar.jpg
  Cache-Control: public, max-age=604800

/avatar.svg
  Cache-Control: public, max-age=604800
